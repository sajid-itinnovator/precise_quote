rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to fetch the authenticated user's profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserTenantId() {
      return getUserData().tenantId;
    }

    // Platform Super Admin Check (Platform SaaS Owner)
    // SECURITY: authorization comes EXCLUSIVELY from the Firebase Auth custom
    // claim `superadmin`, provisioned server-side with the Admin SDK
    // (see scripts/set-superadmin-claim.js). It can never be granted by
    // writing to a user profile document from the client.
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.superadmin == true;
    }

    // ─── Users Collection ───────────────────────────────────────────────
    match /users/{userId} {
      // User can read their own profile; Tenant Admin reads team; Platform Super Admin can view operational accounts
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        getUserTenantId() == resource.data.tenantId ||
        isSuperAdmin()
      );
      // New user registration (own profile) or admin creating team member
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        getUserData().role == 'admin' ||
        isSuperAdmin()
      );
      // Platform Super Admin manages everything; tenant admins manage their own
      // team (staying inside the tenant); a user may update their own profile
      // but can NEVER change their own role, tenantId or dataAccess — this
      // blocks self-escalation and cross-tenant hopping.
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().role == 'admin' &&
          getUserTenantId() == resource.data.tenantId &&
          request.resource.data.tenantId == resource.data.tenantId) ||
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.dataAccess == resource.data.dataAccess)
      );
      // Admin deletes team member; SuperAdmin can remove accounts
      allow delete: if isAuthenticated() && (
        (getUserData().role == 'admin' && getUserTenantId() == resource.data.tenantId) ||
        isSuperAdmin()
      );
    }

    // ─── Tenant Configuration & Subscriptions ───────────────────────────
    match /config/{configId} {
      // Tenant reads own config; SuperAdmin can read/write subscription records for plan management
      allow read: if isAuthenticated() && (
        (resource == null || resource.data.tenantId == getUserTenantId()) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource == null || request.resource.data.tenantId == getUserTenantId()) ||
        isSuperAdmin()
      );
    }

    // ─── DPDP ACT COMPLIANT SENSITIVE DATA ENFORCEMENT ─────────────────
    // The collections below contain private client information and confidential
    // studio quotes. Platform owners and third parties are STRICTLY BLOCKED.
    
    // ─── Clients Directory (Personal Contact Information) ───────────────
    match /clients/{clientId} {
      allow read, write: if isAuthenticated() && (
        (resource == null || resource.data.tenantId == getUserTenantId()) &&
        (request.resource == null || request.resource.data.tenantId == getUserTenantId())
      );
    }

    // ─── Projects ────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read, write: if isAuthenticated() && (
        (resource == null || resource.data.tenantId == getUserTenantId()) &&
        (request.resource == null || request.resource.data.tenantId == getUserTenantId())
      );
    }

    // ─── Quotations & Invoices (Confidential Pricing & Margins) ──────────
    match /quotations/{quotationId} {
      allow read, write: if isAuthenticated() && (
        (resource == null || resource.data.tenantId == getUserTenantId()) &&
        (request.resource == null || request.resource.data.tenantId == getUserTenantId())
      );
    }

    // ─── Products & Material Presets ─────────────────────────────────────
    match /products/{productId} {
      allow read, write: if isAuthenticated() && (
        (resource == null || resource.data.tenantId == getUserTenantId()) &&
        (request.resource == null || request.resource.data.tenantId == getUserTenantId())
      );
    }
  }
}
